# Copy to .env and fill in. .env is gitignored.
DATABASE_URL=postgresql+psycopg://storm_hub_app:CHANGE_ME@localhost/storm_hub
REDIS_URL=redis://localhost:6379/0
# Auth token signing key -- MUST be set to a real random value in every real deployment.
# apps/hub/config.py falls back to a hardcoded, publicly-known dev secret if this is absent --
# generate a real one with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME
# /docs,/redoc,/openapi.json are disabled unless set to 1 -- leave off in production.
ENABLE_API_DOCS=0

# Proxy provider account passwords, used by scripts/gen_proxy_pool.py
SOAX_PASSWORD=
WEBSHARE_PASSWORD=
