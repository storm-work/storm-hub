# ptbot pure-API booking bot (v3) — config (copy to .env and fill in)

# The Next dashboard API (same one orchestrator.py and the browser extensions use)
NEXT_API_BASE=https://vmi3271966.contaboserver.net:8447
# = the dashboard's SOCKET_INTERNAL_SECRET (sent as the x-socket-secret header)
MACHINE_TOKEN=REPLACE_WITH_SOCKET_INTERNAL_SECRET

# reCAPTCHA Enterprise solvers — CapSolver tried first (faster), Anti-Captcha as fallback.
# Anti-Captcha supports multiple comma-separated keys (rotated on failure).
CAPSOLVER_API_KEY=
ANTICAPTCHA_API_KEYS=

# How many accounts this process runs concurrently (asyncio semaphore — this bot has none
# of the AdsPower per-profile resource cost, so it scales further than 1 per OS process).
CONCURRENCY=5
MAX_RETRIES_PER_ACCOUNT=3
# How often (seconds) the main loop polls /api/settings + tops up claimed accounts.
POLL_INTERVAL=5

# Booking target — POSTO_ID is only a FALLBACK; the live value comes from the dashboard's
# /api/settings (postoId), same as the browser extensions.
POSTO_ID=5084
COUNTRY_OF_RESIDENCE=CPV
NATIONALITY=CPV
DURATION_OF_STAY_DAYS=7
LANGUAGE=PT

# --- Slot-watch mode -------------------------------------------------------------
# Reaching Schedule.jsp costs 2 captchas + the Playwright leg's page assets; a /slots
# re-query costs 1 captcha + a few KB. So arrive once, then watch. SLOT_POLL_INTERVAL is
# the TARGET gap in seconds — the actual sleep is jittered around it (a request landing on
# an exact 60.000s cadence is a cleaner tell than anything in its contents).
# SLOT_WATCH_MAX_MINUTES=0 means watch until the session dies, then rebuild and resume.
SLOT_WATCH=1
SLOT_POLL_INTERVAL=60
SLOT_WATCH_MAX_MINUTES=0

# Force a posto for this process, outranking the dashboard's postoId. Leave EMPTY in normal
# operation so a dashboard-side posto change still propagates. Set it only to point this bot
# at a different consular post without redirecting the AdsPower/extension workers too.
POSTO_ID_OVERRIDE=
# Applicant address town written to Formulario field f45. Leave empty to keep whatever
# second_form_mapping_2.json says; set it when COUNTRY_OF_RESIDENCE is not Cape Verde, so the
# form does not declare residence in one country and an address in another.
RESIDENCE_ADDRESS=
# Open Schedule.jsp directly in the browser after login, skipping the application flow. Falls back
# to questionnaire -> Formulario -> ScheduleController when the direct page is not usable.
DIRECT_SCHEDULE=1

# Days ahead to declare as intended arrival. The Schedule calendar rejects any appointment later
# than this date, so it must exceed the post booking horizon (Lyon offers from ~35 days out).
INTENDED_ARRIVAL_DAYS=150
